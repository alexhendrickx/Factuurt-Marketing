# Productie-URL van de app voor de "Start gratis"-CTA (PLAN §10 · §13 beslist 2026-07-14)
NEXT_PUBLIC_APP_URL=https://factuurt.vercel.app/register

# Canonieke URL van de marketing-site zelf (OG, canonical, sitemap). Nog te
# bevestigen bij M5-deploy; laat leeg om de default in src/content/site.ts te gebruiken.
NEXT_PUBLIC_SITE_URL=

# Contactformulier (PLAN §10) — Resend. RESEND_API_KEY is server-only (nooit NEXT_PUBLIC).
RESEND_API_KEY=
# Bestemmingsadres voor contactberichten (§13 beslist 2026-07-14).
CONTACT_TO_EMAIL=alexhendrickx01@gmail.com

# Screenshot-pipeline (scripts/take-screenshots.ts) — inloggen op de lokale
# factuurt-demo-seed. Defaults matchen ../factuurt/scripts/seed-test-account.ts.
SCREENSHOT_USER=maxime@test.com
SCREENSHOT_PASS=maxime2026
